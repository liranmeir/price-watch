# Database (Postgres — e.g. Vercel Postgres, Neon, Supabase)
DATABASE_URL="postgresql://user:password@host/db?pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db"

# Secret the Vercel Cron job must send as "Authorization: Bearer <value>"
# to hit /api/cron/check-prices. Generate with: openssl rand -base64 32
CRON_SECRET=""

# NOTE: there is currently no sign-in / access control on this app — anyone
# with the URL can view and edit everything. See the README's "No auth
# right now" section before deploying this somewhere public.
