# Database (Postgres — e.g. Vercel Postgres, Neon, Supabase)
DATABASE_URL="postgresql://user:password@host/db?pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (can reuse credentials from another project of yours —
# just add this app's callback URL as an authorized redirect URI:
# http://localhost:3000/api/auth/callback/google in dev,
# https://yourdomain.com/api/auth/callback/google in production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of Google account emails allowed to sign in.
# Required — sign-in is refused entirely if this is empty.
ALLOWED_EMAILS=""

# Secret the Vercel Cron job must send as "Authorization: Bearer <value>"
# to hit /api/cron/check-prices. Generate with: openssl rand -base64 32
CRON_SECRET=""
