# Database (Postgres — e.g. Vercel Postgres, Neon, Supabase)
DATABASE_URL="postgresql://user:password@host/db?pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db"

# Secret the Vercel Cron job must send as "Authorization: Bearer <value>"
# to hit /api/cron/check-prices. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Single shared password gating the whole app (see lib/site-auth.ts +
# middleware.ts) — not per-user accounts, just a deterrent against the
# open internet. Required — the dashboard is unreachable for everyone
# (fails closed) if this is empty.
SITE_PASSWORD=""

# Public origin of this deployment (no trailing slash), e.g.
# "https://price-watch.liranmeir.com". Required for the remote MCP server's
# OAuth metadata (app/.well-known/*) to build correct endpoint URLs — point
# it at a *.vercel.app preview and MCP clients get URLs they can't use.
APP_URL=""
